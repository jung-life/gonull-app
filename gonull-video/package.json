{
  "name": "gonull-video",
  "version": "1.0.0",
  "description": "Onboarding video for GoNull app",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion render GoNullOnboarding ../app/src/main/res/raw/onboarding.mp4",
    "render": "remotion render GoNullOnboarding ../app/src/main/res/raw/onboarding.mp4",
    "render-preview": "remotion render GoNullOnboarding out/onboarding.mp4",
    "render-gif": "remotion render GoNullOnboarding out/onboarding.gif --image-format=png",
    "render-ad": "remotion render DoomscrollAd out/doomscroll.mp4",
    "render-ad-blur": "remotion render DoomscrollAdBlurred out/doomscroll-blurred.mp4",
    "render-slides": "remotion still Slide1 out/slides/slide-1.png && remotion still Slide2 out/slides/slide-2.png && remotion still Slide3 out/slides/slide-3.png && remotion still Slide4 out/slides/slide-4.png && remotion still Slide5 out/slides/slide-5.png"
  },
  "keywords": [
    "remotion",
    "video",
    "gonull"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@remotion/bundler": "^4.0.417",
    "@remotion/cli": "^4.0.417",
    "@remotion/google-fonts": "^4.0.512",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remotion": "^4.0.417"
  },
  "devDependencies": {
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.9.3"
  }
}
