<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <!-- An active device admin makes uninstall require deactivation first;
             that's the speed bump Lock Mode relies on. No password policy is
             enforced — limit-password is declared only to register the admin. -->
        <limit-password />
    </uses-policies>
</device-admin>
